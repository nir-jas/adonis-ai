{
  "name": "adonis-ai-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test && npm run test:release-scripts",
    "test:release-scripts": "node --test scripts/*.spec.mjs",
    "test:package-consumer": "node ./scripts/test-packed-consumer.mjs",
    "typecheck": "turbo run typecheck",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "release:verify": "node ./scripts/verify-published-release.mjs"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^6.0.3"
  }
}
