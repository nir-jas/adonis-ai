{
  "name": "adonis-ai",
  "version": "0.1.0-alpha.1",
  "description": "A Laravel-inspired AI SDK for AdonisJS 7",
  "keywords": [
    "adonisjs",
    "adonisjs7",
    "adonisjs-package",
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "ai-gateway",
    "ai-agents",
    "agentic-ai",
    "llm",
    "typescript",
    "nodejs",
    "openai",
    "anthropic",
    "streaming",
    "structured-output",
    "tool-calling",
    "zod"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "files": [
    "build",
    "README.md"
  ],
  "exports": {
    ".": "./build/index.js",
    "./provider": "./build/src/provider.js",
    "./events": "./build/src/events.js",
    "./providers/ai-sdk": "./build/src/providers/ai_sdk_provider.js",
    "./providers/openai": "./build/src/providers/openai_provider.js",
    "./providers/anthropic": "./build/src/providers/anthropic_provider.js",
    "./providers/gateway": "./build/src/providers/gateway_provider.js",
    "./services/main": "./build/services/main.js",
    "./ai_provider": "./build/providers/ai_provider.js",
    "./commands": "./build/commands/main.js",
    "./testing": "./build/src/testing.js",
    "./configure": "./build/configure.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node ./scripts/clean.mjs && tsc -p tsconfig.build.json && npm run copy:stubs",
    "copy:stubs": "node ./scripts/copy-stubs.mjs",
    "lint": "prettier --check .",
    "test": "node --import=tsx --test \"tests/**/*.spec.ts\"",
    "test:live:openai": "AI_LIVE_PROVIDER=openai node --import=tsx --test tests/live/provider.live.spec.ts",
    "test:live:anthropic": "AI_LIVE_PROVIDER=anthropic node --import=tsx --test tests/live/provider.live.spec.ts",
    "test:live:gateway": "AI_LIVE_PROVIDER=gateway node --import=tsx --test tests/live/provider.live.spec.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.25",
    "@ai-sdk/openai": "^4.0.25",
    "ai": "^7.0.44",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@adonisjs/assembler": "^8.0.0",
    "@adonisjs/core": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@adonisjs/assembler": {
      "optional": true
    }
  },
  "devDependencies": {
    "@adonisjs/assembler": "^8.4.0",
    "@adonisjs/core": "^7.3.5",
    "@types/node": "^26.1.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nir-jas/adonis-ai.git"
  },
  "bugs": {
    "url": "https://github.com/nir-jas/adonis-ai/issues"
  },
  "homepage": "https://github.com/nir-jas/adonis-ai#readme"
}
